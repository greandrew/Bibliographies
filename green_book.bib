@Article{Osadchiy2019a,
  author   = {Timur Osadchiy and Ivan Poliakov and Patrick Olivier and Maisie Rowland and Emma Foster},
  title    = {Recommender system based on pairwise association rules},
  journal  = {Expert Systems with Applications},
