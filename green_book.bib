@Article{Lee1997a,
  author   = {J. {Lee} and J. {Oh}},
  title    = {{Hybrid Learning of Mapping and its Jacobian in Multilayer Neural Networks}},
  journal  = {{Neural Computation}},
  year     = {1997},
  volume   = {9},
  number   = {5},
  pages    = {937-958},
  month    = {July},
  issn     = {0899-7667},
  abstract = {There are some learning problems for which a priori information, such as the Jacobian of mapping, is available in addition to input-output examples. This kind of information can be beneficial in neural network learning if it can be embedded into the network. This article is concerned with the method for learning the mapping and available Jacobian simultaneously. The basic idea is to minimize the cost function, which is composed of the mapping error and the Jacobian error. Prior to developing the Jacobian learning rule, we develop an explicit and general method for computing the Jacobian of the neural network using the parameters computed in error backpropagation. Then the Jacobian learning rule is derived. The method is simpler and more general than tangent propagation (Simard, Victorri, Le Cun, & Denker, 1992). Through hybridization of the error backpropagation and the Jacobian learning, the hybrid learning algorithm is presented. The method shows good performance in accelerating the learning speed and improving generalization. And through computer experiments, it is shown that using the Jacobian synthesized from noise-corrupted data can accelerate learning speed.},
  doi      = {10.1162/neco.1997.9.5.937},
}

@Article{Kukacka2017a,
  author      = {Jan Kukačka and Vladimir Golkov and Daniel Cremers},
  title       = {{Regularization for Deep Learning: A Taxonomy}},
  journal     = {{Arxiv}},
  year        = {2017},
  note        = {Available at \url{https://arxiv.org/abs/1710.10686}},
  abstract    = {Regularization is one of the crucial ingredients of deep learning, yet the term regularization has various definitions, and regularization methods are often studied separately from each other. In our work we present a systematic, unifying taxonomy to categorize existing methods. We distinguish methods that affect data, network architectures, error terms, regularization terms, and optimization procedures. We do not provide all details about the listed methods; instead, we present an overview of how the methods can be sorted into meaningful categories and sub-categories. This helps revealing links and fundamental similarities between them. Finally, we include practical recommendations both for users and for developers of new regularization methods.},
  date        = {2017-10-29},
  eprint      = {1710.10686v1},
  eprintclass = {cs.LG},
  eprinttype  = {arXiv},
  file        = {online:http\://arxiv.org/pdf/1710.10686v1:PDF},
  keywords    = {cs.LG, cs.AI, cs.CV, cs.NE, stat.ML, 62M45, I.2.6; I.5},
}

