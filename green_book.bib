@Article{Palm1980a,
  author   = {Palm, G.},
  title    = {On associative memory},
  journal  = {Biological Cybernetics},
  year     = {1980},
  volume   = {36},
  number   = {1},
  pages    = {19--31},
  month    = {Feb},
  issn     = {1432-0770},
  abstract = {The information storing capacity of certain associative and auto-associative memories is calculated. For example, in a 100{\texttimes}100 matrix of 1 bit storage elements more than 6,500 bits can be stored associatively, and more than 688,000 bits in a 1,000{\texttimes}1,000 matrix. Asymptotically, the storage capacity of an associative memory increases proportionally to the number of storage elements. The usefulness of associative memories, as opposed to conventional listing memories, is discussed --- especially in connection with brain modelling.},
  day      = {01},
  doi      = {10.1007/BF00337019},
